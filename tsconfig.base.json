{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@component-hub/plugin": ["./tools/component-hub-plugin/src/index.ts"],
      "storybook-host": ["./tools/storybook-host/src/index.ts"],
      "@organization/date-range-picker": [
        "./packages/components/date-range-picker/src/index.ts"
      ],
      "@organization/date-range-picker/metadata": [
        "./packages/components/date-range-picker/component.json"
      ],
      "@organization/date-range-picker/package": [
        "./packages/components/date-range-picker/package.json"
      ],
      "@organization/notification-banner": [
        "./packages/components/notification-banner/src/index.ts"
      ],
      "@organization/notification-banner/metadata": [
        "./packages/components/notification-banner/component.json"
      ],
      "@organization/notification-banner/package": [
        "./packages/components/notification-banner/package.json"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
