{
  "name": "date-range-picker",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/components/date-range-picker/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [
    "type:component",
    "scope:shared",
    "maturity:poc",
    "publishable"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/components/date-range-picker/ng-package.json",
        "tsConfig": "packages/components/date-range-picker/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/components/date-range-picker/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "packages/components/date-range-picker/.storybook",
        "browserTarget": "date-range-picker:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": [
        "{options.outputDir}"
      ],
      "options": {
        "outputDir": "dist/storybook/date-range-picker",
        "configDir": "packages/components/date-range-picker/.storybook",
        "browserTarget": "date-range-picker:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": [
        "build-storybook"
      ],
      "options": {
        "buildTarget": "date-range-picker:build-storybook",
        "staticFilePath": "dist/storybook/date-range-picker",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "date-range-picker:build-storybook:ci"
        }
      }
    }
  }
}
